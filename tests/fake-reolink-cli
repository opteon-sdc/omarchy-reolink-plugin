#!/bin/bash
# Stand-in for reolink-cli: two demo cameras with pan/tilt and a synthetic video feed.
# Try the plugin without hardware by pointing the "Path to reolink-cli" setting here.

set -euo pipefail

args=" $* "
reply() { printf '%s\n' "$1"; }

# The demo registry lives in a runtime file, so adding and removing cameras sticks
# for the session. Delete the file to start over.
registry() {
  local file=${XDG_RUNTIME_DIR:-/tmp}/reolink-fake-registry.json
  [[ -s $file ]] || printf '%s\n' '[
    {"camera":"front-door","host":"192.0.2.41:9000","uid":null,"user":"admin","description":"Demo doorbell","tags":["outdoor"],"disabled":false},
    {"camera":"garden","host":"192.0.2.42:9000","uid":null,"user":"admin","description":"Demo pan/tilt camera","tags":["outdoor"],"disabled":false},
    {"camera":"example","host":null,"uid":"0000","user":"admin","description":null,"tags":[],"disabled":true}]' >"$file"
  printf '%s\n' "$file"
}

# device add|update|remove NAME [--host H] [--uid U] [--user U] [--description D] [--disabled B] [--password-stdin]
device_command() {
  local action="" name="" host="" uid="" user="" description="" disabled="" has_description=0 file
  while (( $# )); do
    case $1 in
      add | update | remove) [[ -z $action ]] && { action=$1; name=$2; shift; } ;;
      --host) host=$2; shift ;;
      --uid) uid=$2; shift ;;
      --user) user=$2; shift ;;
      --description) description=$2; has_description=1; shift ;;
      --disabled) disabled=${2:-true}; [[ $disabled == true || $disabled == false ]] && shift || disabled=true ;;
      --password-stdin) IFS= read -r _ || true ;;
    esac
    shift
  done
  file=$(registry)
  local exists
  exists=$(jq --arg n "$name" 'any(.[]; .camera == $n)' "$file")
  if [[ $action == add && $exists == true ]] || [[ $action != add && $exists != true ]]; then
    reply "{\"ok\":false,\"command\":\"device\",\"data\":null,\"error\":{\"message\":\"device $action failed for $name\"}}"
    exit 1
  fi
  case $action in
    add)
      jq --arg n "$name" --arg h "$host" --arg u "$uid" --arg user "${user:-admin}" --arg d "$description" \
        '. + [{camera: $n, host: ($h | select(. != "") // null), uid: ($u | select(. != "") // null), user: $user,
               description: ($d | select(. != "") // null), tags: [], disabled: false}]' "$file" ;;
    update)
      jq --arg n "$name" --arg h "$host" --arg u "$uid" --arg user "$user" --arg d "$description" \
         --argjson hd "$has_description" --arg dis "$disabled" \
        'map(if .camera == $n then
           (if $h != "" then .host = $h | .uid = null else . end)
           | (if $u != "" then .uid = $u | .host = null else . end)
           | (if $user != "" then .user = $user else . end)
           | (if $hd == 1 then .description = ($d | select(. != "") // null) else . end)
           | (if $dis != "" then .disabled = ($dis == "true") else . end)
         else . end)' "$file" ;;
    remove)
      jq --arg n "$name" 'map(select(.camera != $n))' "$file" ;;
  esac >"$file.new" && mv "$file.new" "$file"
  local done=${action%e}ed
  reply "{\"ok\":true,\"command\":\"device\",\"data\":{\"action\":\"$done\"},\"error\":null}"
}

case "$args" in
  *" --version "*)
    reply "reolink-cli 0.0.0 (fake)" ;;
  *" gateway status "*)
    reply '{"ok":true,"command":"gateway.status","data":{"addr":"127.0.0.1:9000","listening":true},"error":null}' ;;
  *" device list "*)
    reply "$(jq -c '{ok: true, command: "device", data: ., error: null}' "$(registry)")" ;;
  *" device add "* | *" device update "* | *" device remove "*)
    device_command "$@" ;;
  *" discover "*)
    sleep 1
    reply '{"ok":true,"command":"discover","data":{"count":2,"devices":[
      {"host":"192.0.2.42:9000","uid":"95270000DEMO0042","mac":"ec:71:db:00:00:42","scopes":["reolink-lan://name/Garden","reolink-lan://hardware/E1%20Pro"]},
      {"host":"192.0.2.43:9000","uid":"95270000DEMO0043","mac":"ec:71:db:00:00:43","scopes":["reolink-lan://name/Back%20Door","reolink-lan://hardware/Argus%204%20Pro"]}]},"error":null}' ;;
  *" login "*)
    # Accepts the password "demo" on stdin, like `--password-stdin`.
    IFS= read -r password || true
    if [[ $password == demo ]]; then
      reply '{"ok":true,"command":"login","data":{"model":"Demo"},"error":null}'
    else
      reply '{"ok":false,"command":"login","data":null,"error":{"code":"AUTH_ERROR","message":"login failed: wrong user name or password"}}'
      exit 1
    fi ;;
  *" capabilities "*)
    reply '{"ok":true,"command":"capabilities","data":{"ptzMode":"pt","item":{"ptzType":"3"}},"error":null}' ;;
  *" ptz preset list "*)
    reply '{"ok":true,"command":"ptz","data":{"channel":0,"maxPresetNum":64,"presets":[{"id":1,"name":"Driveway"},{"id":2,"name":"Gate"},{"id":3,"name":"Terrace"}]},"error":null}' ;;
  *" ptz "*)
    reply '{"ok":true,"command":"ptz","data":{"channel":0},"error":null}' ;;
  *" snapshot "*)
    file=""
    while (( $# )); do [[ $1 == --file || $1 == -o ]] && { file=$2; break; }; shift; done
    [[ -n $file ]] || { echo "fake: snapshot needs --file" >&2; exit 2; }
    ffmpeg -loglevel error -f lavfi -i "gradients=s=1920x1080:c0=0x1d2b53:c1=0x7e2553:c2=0x008751:speed=0" \
      -frames:v 1 -y "$file"
    reply '{"ok":true,"command":"snapshot","data":{},"error":null}' ;;
  *" events stream "*)
    # NDJSON like the real gateway: an event start (status MD), its end, and ambient raw reports.
    # FAKE_EVENT_INTERVAL sets the seconds between events (default 20).
    interval=${FAKE_EVENT_INTERVAL:-20}
    limit=0
    while (( $# )); do [[ $1 == --timeout ]] && { limit=$2; break; }; shift; done
    hosts=(192.0.2.41:9000 192.0.2.42:9000)
    kinds=("motion none" "motion people" "people people" "vehicle vehicle" "dog_cat dog_cat")
    start=$SECONDS n=0
    while (( limit == 0 || SECONDS - start < limit )); do
      sleep "$interval"
      host=${hosts[n % 2]}
      read -r type ai <<<"${kinds[n % ${#kinds[@]}]}"
      ais="[]"; [[ $ai != none ]] && ais="[\"$ai\"]"
      now=$(date +%s)
      printf '{"timestamp":%d,"channel":0,"eventType":"%s","device":"%s","data":{"status":"MD","aiType":"%s","aiTypes":%s}}\n' \
        "$now" "$type" "$host" "$ai" "$ais"
      printf '{"timestamp":%d,"channel":0,"eventType":"raw.cmd33","device":"%s","data":{}}\n' "$now" "$host"
      printf '{"timestamp":%d,"channel":0,"eventType":"none","device":"%s","data":{"status":"none","aiType":"none","aiTypes":[]}}\n' \
        "$((now + 1))" "$host"
      n=$((n + 1))
    done ;;
  *" preview capture "*)
    exec ffmpeg -loglevel error -re -f lavfi \
      -i "gradients=s=896x504:rate=15:c0=0x1d2b53:c1=0x7e2553:c2=0x008751:c3=0xffa300:speed=0.015,drawtext=text='%{localtime\:%T}':x=24:y=20:fontsize=28:fontcolor=white" \
      -c:v libx264 -preset ultrafast -tune zerolatency -f h264 - ;;
  *)
    reply '{"ok":false,"command":"fake","data":null,"error":{"message":"fake reolink-cli: unsupported command"}}'
    exit 1 ;;
esac
